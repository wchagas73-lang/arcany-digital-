# Google Places API — configure somente no servidor (Vercel / ambiente local)
GOOGLE_PLACES_API_KEY=

# Supabase — projeto PostgreSQL + Auth
NEXT_PUBLIC_SUPABASE_URL=
# Preferencial: chave publicável. A chave anon antiga continua aceita como fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente em servidor. Nunca usar NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=
