# Google Places API. Configure somente no servidor (Vercel / ambiente local).
GOOGLE_PLACES_API_KEY=

# Supabase: URL e chave publicável (ou anon legada) são usadas no cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Allowlist server-side do proprietário usada pelo middleware.
# Deve corresponder ao e-mail permitido pelo trigger de Auth no banco.
ARCANY_OWNER_EMAIL=
